# Copy to .env (git-ignored). Real environment variables win over this file.
# Pick ONE provider. If SCOUT_PROVIDER is empty the first key found wins
# (order: cortensor-portal, openrouter, openai).
SCOUT_PROVIDER=cortensor-portal

# Cortensor Portal (OpenAI-compatible, https://api.cortensor.app/v1, model oss-20b)
CORTENSOR_API_KEY=

# OpenRouter (default model openai/gpt-4.1-mini)
OPENROUTER_API_KEY=

# OpenAI (default model gpt-4.1-mini)
OPENAI_API_KEY=

# Ollama (local, no key; default model llama3.1)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional overrides
# SCOUT_MODEL=oss-20b
# SCOUT_BASE_URL=            # any OpenAI-compatible endpoint
# SCOUT_LOG_LEVEL=WARNING    # OpenMinion runtime log level
# SCOUT_OPENMINION_MEMORY=0  # 1 = enable OpenMinion long-term memory (extra LLM call per run)
# SCOUT_SEEN_FILE=./seen.json
